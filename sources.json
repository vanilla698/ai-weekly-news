{
  "modules": {
    "ai_giants": {
      "enabled": true,
      "max_items": 6,
      "sources": [
        {"name": "OpenAI", "url": "https://openai.com/news/rss.xml", "type": "rss"},
        {"name": "Anthropic", "url": "https://www.anthropic.com/rss.xml", "type": "rss"},
        {"name": "Google AI", "url": "https://blog.google/technology/ai/rss/", "type": "rss"},
        {"name": "DeepMind", "url": "https://deepmind.google/blog/rss.xml", "type": "rss"},
        {"name": "NVIDIA", "url": "https://blogs.nvidia.com/feed/", "type": "rss"},
        {"name": "HuggingFace Blog", "url": "https://huggingface.co/blog/feed.xml", "type": "rss"}
      ]
    },
    "auto_companies": {
      "enabled": true,
      "max_items": 6,
      "sources": [
        {"name": "BMW", "url": "https://www.press.bmwgroup.com/global/rss", "type": "rss"},
        {"name": "Polestar", "url": "https://media.polestar.com/rss", "type": "rss"},
        {"name": "Volvo", "url": "https://www.media.volvocars.com/global/rss", "type": "rss"},
        {"name": "Ford", "url": "https://media.ford.com/content/fordmedia/feeds/us/news.rss", "type": "rss"},
        {"name": "BYD", "url": "https://www.bydeurope.com/rss", "type": "rss"},
        {"name": "Hyundai", "url": "https://www.hyundaimotorgroup.com/en/news/rss.do", "type": "rss"}
      ]
    },
    "cn_tech": {
      "enabled": true,
      "max_items": 6,
      "sources": [
        {"name": "爱范儿", "url": "https://www.ifanr.com/feed", "type": "rss"},
        {"name": "极客公园", "url": "https://www.geekpark.net/rss", "type": "rss"},
        {"name": "IT之家", "url": "https://www.ithome.com/rss/", "type": "rss"},
        {"name": "36氪", "url": "https://36kr.com/feed", "type": "rss"},
        {"name": "钛媒体", "url": "https://www.tmtpost.com/rss.xml", "type": "rss"}
      ]
    },
    "arxiv": {
      "enabled": true,
      "max_per_category": 8,
      "categories": ["cs.AI", "cs.RO", "cs.CL"]
    },
    "hacker_news": {
      "enabled": true,
      "max_items": 6,
      "min_points": 50,
      "days": 7,
      "keywords": ["ai", "ml", "llm", "gpt", "claude", "agent", "model", "robot", "anthropic", "hugging"]
    },
    "huggingface_models": {
      "enabled": true,
      "max_items": 15,
      "min_likes": 10,
      "days_limit": 30
    }
  },

  "module_targets": {
    "ai_news": 6,
    "auto_tech": 6,
    "leadership": 2,
    "auto_ai": 4,
    "papers": 6,
    "github": 6,
    "ai_deep": 4,
    "models": 6,
    "summary": 6
  },

  "fallback_sources": {
    "ai_news": ["arxiv"],
    "auto_tech": ["auto_companies", "cn_tech"],
    "leadership": ["auto_companies"],
    "auto_ai": ["arxiv"],
    "papers": ["arxiv"],
    "github": ["huggingface_models"],
    "ai_deep": ["hacker_news", "ai_giants"],
    "models": ["huggingface_models"]
  }
}
